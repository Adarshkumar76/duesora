# ==============================================================================
# Duesora - Environment Configuration
# Copy this file to .env.local for local development.
# ==============================================================================

# Core Application
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key

# Database (PostgreSQL)
# e.g. local Docker or managed Postgres (Supabase, Neon, RDS, etc.)
DATABASE_URL=postgresql://duesora:duesora@localhost:5432/duesora

# Redis (Caching & Task Queues)
REDIS_URL=redis://localhost:6379

# ==============================================================================
# 1-Click Social Authentication (100% Free - GitHub & Google)
# ==============================================================================
# GitHub OAuth App:
# 1. Go to https://github.com/settings/developers -> "New OAuth App"
# 2. Homepage URL: http://localhost:3000 (or your production domain)
# 3. Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth Client:
# 1. Go to https://console.cloud.google.com/apis/credentials -> "Create Credentials" -> "OAuth Client ID" (Web application)
# 2. Authorized JavaScript origins: http://localhost:3000 (or your production domain)
# 3. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ==============================================================================
# Email & Alerts (SMTP - Optional in local development)
# When unset, Duesora runs in Simulation Mode and logs outgoing emails to stdout.
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Duesora Notifications <notifications@duesora.local>"

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads

# Security & System Automation
TRUST_PROXY=false
LOG_LEVEL=info
CRON_SECRET=replace-with-a-secure-cron-secret
